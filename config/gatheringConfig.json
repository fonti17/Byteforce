{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catering Information Gathering - Part 1",
  "description": "Minimum information required before continuing to detailed catering preferences.",
  "type": "object",
  "required": [
    "eventType",
    "date",
    "participantCount",
    "meal",
    "budget"
  ],
  "properties": {
    "eventType": {
      "type": "string",
      "enum": [
        "private",
        "business",
        "team_event",
        "other"
      ]
    },
    "date": {
      "type": "object",
      "required": [
        "day",
        "month"
      ],
      "properties": {
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "participantCount": {
      "type": "integer",
      "minimum": 1
    },
    "meal": {
      "type": "string",
      "enum": [
        "breakfast",
        "lunch",
        "dinner",
        "other"
      ]
    },
    "budget": {
      "type": "object",
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
