{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catering Menu and Shopping List",
  "description": "Structured result of the catering planning step.",
  "type": "object",
  "required": [
    "menu",
    "shoppingList",
    "budget",
    "reasoning"
  ],
  "properties": {
    "menu": {
      "type": "object",
      "required": [
        "name",
        "items"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Short name for the complete menu."
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Name of a dish or menu component."
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Short description of the dish."
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "shoppingList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ingredient",
          "quantity",
          "unit"
        ],
        "properties": {
          "ingredient": {
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Total quantity required for all participants."
          },
          "unit": {
            "type": "string",
            "enum": [
              "g",
              "kg",
              "ml",
              "l",
              "piece",
              "pack"
            ]
          },
          "category": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional shopping category, for example vegetables or dairy."
          }
        },
        "additionalProperties": false
      }
    },
    "budget": {
      "type": "object",
      "required": [
        "currency",
        "estimatedTotal",
        "note"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "estimatedTotal": {
          "type": "number",
          "minimum": 0
        },
        "note": {
          "type": "string",
          "description": "Short explanation of how the proposal fits the available budget."
        }
      },
      "additionalProperties": false
    },
    "reasoning": {
      "type": "string",
      "description": "Explanation of how the proposal handles the budget, preferences, constraints, and any requests that could not be fulfilled exactly."
    }
  },
  "additionalProperties": false
}
