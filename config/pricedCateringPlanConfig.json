{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Priced catering plan",
  "description": "Final format after the LLM plan has been enriched with PRODEGA data.",
  "type": "object",
  "required": ["menu", "shoppingList", "budget", "pricing"],
  "properties": {
    "menu": { "type": "object" },
    "shoppingList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ingredient", "quantity", "unit", "pricingStatus"],
        "properties": {
          "ingredient": { "type": "string" },
          "quantity": { "type": "number", "exclusiveMinimum": 0 },
          "unit": { "type": "string" },
          "category": { "type": ["string", "null"] },
          "pricingStatus": { "enum": ["matched", "not_found", "quantity_unknown"] },
          "pricingMessage": { "type": ["string", "null"] },
          "productName": { "type": ["string", "null"] },
          "articleNumber": { "type": ["string", "null"] },
          "unitPriceChf": { "type": ["number", "null"], "minimum": 0 },
          "priceUnit": { "type": ["string", "null"] },
          "packageQuantity": { "type": ["string", "null"] },
          "packagePriceChf": { "type": ["number", "null"], "minimum": 0 },
          "packagesNeeded": { "type": ["integer", "null"], "minimum": 1 },
          "estimatedTotalChf": { "type": ["number", "null"], "minimum": 0 },
          "productUrl": { "type": ["string", "null"], "format": "uri" },
          "isAvailable": { "type": ["boolean", "null"] }
        },
        "additionalProperties": false
      }
    },
    "budget": { "type": "object" },
    "pricing": {
      "type": "object",
      "required": ["source", "currency", "estimatedTotal", "isComplete"],
      "properties": {
        "source": { "const": "PRODEGA" },
        "currency": { "const": "CHF" },
        "estimatedTotal": { "type": "number", "minimum": 0 },
        "isComplete": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
