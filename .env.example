# Apertus v1.5 8B (Stoney Cloud)
VITE_APERTUS_8B_ENDPOINT=https://llm.stoney-cloud.com/v1/chat/completions
VITE_APERTUS_8B_KEY=your_stoney_key_here
VITE_APERTUS_8B_MODEL=apertus-ai/Apertus-v1.5-8B

# Apertus v1.5 70B (onprem.ai)
VITE_APERTUS_70B_ENDPOINT=https://llm-api2.b.onprem.ai/openai/v1/chat/completions
VITE_APERTUS_70B_KEY=your_onprem_key_here
VITE_APERTUS_70B_MODEL=apertus-v1.5-70b

# Default Model Selection ('apertus-8b' | 'apertus-70b')
VITE_DEFAULT_LLM_MODEL=apertus-70b

# Use Vite proxy in development to prevent CORS issues (default: true)
VITE_USE_PROXY=true
